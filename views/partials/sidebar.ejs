<aside class="sidebar" id="sidebar">
  <a class="brand" href="/" aria-label="SIPRINT beranda">
    <span class="brand-mark"><img src="/images/logo-cirebon-transparent.png" alt="" width="31" height="37"></span>
    <span class="brand-copy"><strong>SIPRINT</strong><small>LAYANAN INTERNAL</small></span>
  </a>
  <div class="sidebar-section-label">MENU UTAMA</div>
  <nav class="side-nav" aria-label="Navigasi utama">
    <a class="nav-link <%= title === 'Dashboard' ? 'active' : '' %>" href="/">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="2"/><rect x="13" y="3" width="8" height="5" rx="2"/><rect x="13" y="10" width="8" height="11" rx="2"/><rect x="3" y="13" width="8" height="8" rx="2"/></svg>
      <span>Dashboard</span>
    </a>
    <% if (currentUser.role === 'admin') { %>
      <a class="nav-link <%= title === 'Data Pegawai' ? 'active' : '' %>" href="/admin/pegawai">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="4"/><path d="M2 21a7 7 0 0 1 14 0M16 4.5a4 4 0 0 1 0 7.5m2 3a6 6 0 0 1 4 6"/></svg>
        <span>Data Pegawai</span>
      </a>
      <a class="nav-link <%= title === 'Data Dokumen' ? 'active' : '' %>" href="/dokumen">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8m-8 4h8"/></svg>
        <span>Data Dokumen</span>
      </a>
      <a class="nav-link <%= title === 'Antrean Cetak' ? 'active' : '' %>" href="/admin/antrean">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 14h12v8H6zM18 12h.01"/></svg>
        <span>Antrean Cetak</span>
        <% if (typeof queueCount !== 'undefined' && queueCount > 0) { %><span class="nav-count"><%= queueCount %></span><% } %>
      </a>
      <a class="nav-link <%= title === 'Audit Log' ? 'active' : '' %>" href="/admin/audit">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        <span>Audit Log</span>
      </a>
    <% } else { %>
      <a class="nav-link <%= title === 'Kirim Dokumen' ? 'active' : '' %>" href="/dokumen/baru">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4m-5 5 5-5 5 5"/><path d="M4 16v4a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-4"/></svg>
        <span>Kirim Dokumen</span>
      </a>
      <a class="nav-link <%= title === 'Dokumen Saya' ? 'active' : '' %>" href="/dokumen">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8m-8 4h8"/></svg>
        <span>Dokumen Saya</span>
      </a>
    <% } %>
  </nav>
  <div class="sidebar-section-label sidebar-account-label">AKUN</div>
  <nav class="side-nav" aria-label="Pengaturan akun">
    <a class="nav-link <%= title === 'Profil Saya' ? 'active' : '' %>" href="/profil">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
      <span>Profil Saya</span>
    </a>
    <a class="nav-link <%= title === 'Notifikasi' ? 'active' : '' %>" href="/notifikasi">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"/><path d="M10 21h4"/></svg>
      <span>Notifikasi</span>
      <% if (unreadNotificationCount > 0) { %><span class="nav-count"><%= unreadNotificationCount > 9 ? '9+' : unreadNotificationCount %></span><% } %>
    </a>
  </nav>
  <div class="sidebar-bottom">
    <div class="sidebar-help">
      <span class="help-icon">i</span>
      <strong>Butuh bantuan?</strong>
      <span>Hubungi administrator SIPRINT.</span>
    </div>
    <div class="sidebar-user">
      <span class="avatar"><% if (currentUser.profilePhoto) { %><img src="/foto-profil/<%= currentUser.id %>" alt=""><% } else { %><%= currentUser.name.slice(0, 1).toUpperCase() %><% } %></span>
      <span class="sidebar-user-copy"><strong><%= currentUser.name %></strong><small><%= currentUser.role === 'admin' ? 'Administrator' : 'Pegawai' %></small></span>
      <a class="icon-button logout-button" href="/profil" aria-label="Edit profil" title="Edit profil"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg></a>
    </div>
  </div>
</aside>
