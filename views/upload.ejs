<%- include('partials/head', { title, bodyClass: 'app-page' }) %>
<%- include('partials/sidebar') %>
<main class="main-content">
  <%- include('partials/topbar', { title }) %>
  <div class="page-content">
    <%- include('partials/flash') %>
    <section class="page-heading-row"><div><span class="eyebrow">PENGIRIMAN BARU</span><h1>Kirim dokumen</h1><p>Lengkapi detail dokumen untuk dimasukkan ke antrean pencetakan.</p></div><a class="button button-outline" href="/dokumen">← Dokumen saya</a></section>
    <div class="upload-layout">
      <section class="content-card upload-card">
        <div class="card-heading"><div><span class="eyebrow">FORMULIR PENGIRIMAN</span><h2>Detail dokumen</h2></div><span class="step-indicator">01 <i>/</i> 01</span></div>
        <form action="/dokumen" method="post" enctype="multipart/form-data" class="form-stack">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label for="title">Nama dokumen <span class="required-mark">*</span></label>
          <input class="form-control" id="title" name="title" type="text" minlength="2" maxlength="160" placeholder="Contoh: Surat Undangan Rapat" required>
          <div class="form-grid">
            <div class="form-stack"><label for="copies">Jumlah salinan <span class="required-mark">*</span></label><div class="number-control"><button type="button" data-number-step="-1" aria-label="Kurangi salinan">−</button><input id="copies" name="copies" type="number" min="1" max="500" value="1" required><button type="button" data-number-step="1" aria-label="Tambah salinan">+</button></div><span class="field-help">Jumlah salinan antara 1–500.</span></div>
            <div class="form-stack"><label for="notes">Keterangan <span class="optional-mark">Opsional</span></label><input class="form-control" id="notes" name="notes" type="text" maxlength="1000" placeholder="Catatan untuk admin"></div>
          </div>
          <label>File dokumen <span class="required-mark">*</span></label>
          <label class="drop-zone" for="document">
            <span class="upload-symbol"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4m-5 5 5-5 5 5"/><path d="M4 16v4a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-4"/></svg></span>
            <strong>Tarik file ke sini atau <span>pilih file</span></strong>
            <small>Dokumen PDF · Maksimal 15 MB</small>
            <span class="selected-file" data-file-name>Belum ada file dipilih</span>
            <input id="document" name="document" type="file" accept=".pdf,application/pdf" required>
          </label>
          <div class="form-actions"><a class="button button-outline" href="/dokumen">Batal</a><button class="button button-primary" type="submit">Kirim ke antrean <span aria-hidden="true">→</span></button></div>
        </form>
      </section>
      <aside class="upload-aside">
        <div class="info-card"><span class="info-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11z"/><path d="m9 12 2 2 4-4"/></svg></span><h3>Dokumen Anda aman</h3><p>File hanya dapat diakses oleh Anda dan administrator yang berwenang.</p></div>
        <div class="steps-card"><span class="eyebrow">ALUR PENGIRIMAN</span><div class="mini-step"><span>1</span><div><strong>Kirim dokumen</strong><small>Isi detail dan unggah file PDF.</small></div></div><div class="mini-step"><span>2</span><div><strong>Diproses admin</strong><small>Admin memeriksa dan mencetak.</small></div></div><div class="mini-step"><span>3</span><div><strong>Selesai</strong><small>Pantau status di Dokumen Saya.</small></div></div></div>
      </aside>
    </div>
    <footer class="page-footer"><span>© <%= new Date().getFullYear() %> SIPRINT · Kabupaten Cirebon</span><span>LAYANAN INTERNAL</span></footer>
  </div>
</main>
<div class="mobile-overlay"></div>
<%- include('partials/end') %>
