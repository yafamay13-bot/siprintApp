<%- include('partials/head', { title, bodyClass: 'app-page' }) %>
<%- include('partials/sidebar') %>
<main class="main-content">
  <%- include('partials/topbar', { title }) %>
  <div class="page-content">
    <section class="page-heading-row"><div><span class="eyebrow">JEJAK AKTIVITAS</span><h1>Audit log</h1><p>Catatan aktivitas autentikasi dan pengelolaan dokumen, terbaru lebih dahulu.</p></div><span class="queue-total"><span></span><%= logs.length %> aktivitas</span></section>
    <section class="content-card"><div class="table-wrap"><table class="data-table"><thead><tr><th>Aktivitas</th><th>Pengguna</th><th>Objek</th><th>Alamat IP</th><th>Waktu</th><th>Detail</th></tr></thead><tbody>
      <% logs.forEach((log) => { %><tr><td><span class="audit-action"><%= log.action.replaceAll('_', ' ') %></span></td><td><%= log.user_name || 'Akun dihapus' %><small class="table-subline"><%= log.user_email || '' %></small></td><td><%= log.entity_type %><%= log.entity_id ? ` #${log.entity_id}` : '' %></td><td><%= log.ip_address || '—' %></td><td><%= formatDate(log.created_at) %></td><td><details class="audit-details"><summary>Lihat</summary><pre><%= log.details ? JSON.stringify(typeof log.details === 'string' ? JSON.parse(log.details) : log.details, null, 2) : 'Tidak ada detail tambahan' %></pre></details></td></tr><% }) %>
    </tbody></table></div><% if (!logs.length) { %><div class="empty-state compact-empty"><strong>Belum ada aktivitas tercatat</strong><span>Aktivitas sistem akan muncul di sini.</span></div><% } %></section>
    <footer class="page-footer"><span>© <%= new Date().getFullYear() %> SIPRINT · Kabupaten Cirebon</span><span>LAYANAN INTERNAL</span></footer>
  </div>
</main>
<div class="mobile-overlay"></div>
<%- include('partials/end') %>
